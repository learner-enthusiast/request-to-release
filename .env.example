# =============================================================================
# Streamyst monorepo environment
#
# Setup:
#   cp .env.example .env
#   ./setup.sh          # symlinks .env into apps/* and packages/*
#
# Consumed by: apps/api, apps/web, packages/database, packages/services,
#              packages/logger, packages/auth (via @repo/services/env)
# =============================================================================

# -----------------------------------------------------------------------------
# Shared runtime
# -----------------------------------------------------------------------------
# Accepted values: development | prod  ("production" is NOT accepted)
NODE_ENV=development

# Optional. Defaults to "debug" in development, "error" in prod.
# LOGGER_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (packages/database)
# -----------------------------------------------------------------------------
# Local Postgres: docker compose up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev

# -----------------------------------------------------------------------------
# API server (apps/api)
# -----------------------------------------------------------------------------
PORT=8000
BASE_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the API with credentials
CORS_ORIGIN=http://localhost:3000

# Inngest — local dev (run: npx inngest-cli@latest dev)
INNGEST_DEV=1
INNGEST_BASE_URL=http://127.0.0.1:8288
INNGEST_EVENT_KEY=local

# Production Inngest (set INNGEST_DEV=0 and use keys from the Inngest dashboard):
# INNGEST_DEV=0
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Web app (apps/web)
# -----------------------------------------------------------------------------
# Better Auth / API origin (must match BETTER_AUTH_URL when using a tunnel)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# tRPC endpoint. Omit to use the relative path "/trpc" (requires a Next.js proxy).
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc

# Set to "true" to skip Next.js env validation during Docker/CI builds
# SKIP_ENV_VALIDATION=true

# -----------------------------------------------------------------------------
# Auth (packages/auth via packages/services/env)
# -----------------------------------------------------------------------------
# Required. Each secret must be at least 32 characters.
BETTER_AUTH_SECRET=change-me-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:8000

# Legacy JWT secrets (validated at startup; reserved for future use)
ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-32-chars
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Optional — Better Auth social login (leave blank to disable)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# GitHub App (packages/services — PR reviews, repo sync, webhooks)
# -----------------------------------------------------------------------------
# App ID from GitHub App settings
GITHUB_APP_ID=0000000

# PEM private key (use quotes; newlines as \n)
GITHUB_APP_SECRET="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Webhook secret from GitHub App settings
GITHUB_WEBHOOK_SECRET=change-me-github-webhook-secret

# Install URL shown in the repositories UI
GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app-slug/installations/new

# -----------------------------------------------------------------------------
# Pinecone (packages/services — codebase + PR vector search)
# -----------------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX=request-to-release-dev

# -----------------------------------------------------------------------------
# OpenRouter (packages/services — AI PR reviews)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
